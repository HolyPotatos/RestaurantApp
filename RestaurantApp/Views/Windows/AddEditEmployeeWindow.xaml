<Window x:Class="RestaurantApp.Views.Windows.AddEditEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantApp.Views.Windows"
        mc:Ignorable="d"
                Title="{DynamicResource EmployeeWindowTitle}" WindowStyle="None" Height="465" Width="380" 
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" 
        Background="Transparent" AllowsTransparency="True"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" 
                      ResizeBorderThickness="0" 
                      GlassFrameThickness="0" 
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BgColor}" CornerRadius="12" BorderBrush="{DynamicResource BorderDefaultColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="WindowTitleTB" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Left" 
                       FontSize="16" FontWeight="SemiBold"
                       Margin="30,0,0,0" 
                       Foreground="{DynamicResource TextPrimaryColor}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0">
                <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{DynamicResource CloseButtonStyle}" Click="Close_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="30,10,30,20">
                <TextBox x:Name="LastNameTB" Style="{DynamicResource TextBoxStyle}" Tag="{DynamicResource SurnamePlaceholder}" Height="42" Margin="0,0,0,15"/>
                <TextBox x:Name="FirstNameTB" Style="{DynamicResource TextBoxStyle}" Tag="{DynamicResource NamePlaceholder}" Height="42" Margin="0,0,0,15"/>
                <TextBox x:Name="MiddleNameTB" Style="{DynamicResource TextBoxStyle}" Tag="{DynamicResource PatronymicPlaceholder}" Height="42" Margin="0,0,0,15"/>
                <TextBox x:Name="PhoneTB" Style="{DynamicResource TextBoxStyle}" Tag="{DynamicResource PhonePlaceholder}" Height="42" Margin="0,0,0,15"
                         PreviewTextInput="NumberValidation" TextChanged="PhoneTB_TextChanged"/>
                <ComboBox x:Name="TitleComboBox" Style="{DynamicResource ComboBoxStyle}" DisplayMemberPath="Title" SelectedValuePath="ID" Height="42" Margin="0,0,0,15"/>
                <TextBox x:Name="LoginTB" Style="{DynamicResource TextBoxStyle}" Tag="{DynamicResource LoginPlaceholder}" Height="42" Margin="0,0,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{DynamicResource CancelBtn}" Margin="0,0,5,0" Style="{DynamicResource SecondaryButtonStyle}" Height="45" Click="Close_Click"/>
                    <Button Grid.Column="1" Content="{DynamicResource SaveBtn}" Margin="5,0,0,0" Style="{DynamicResource PrimaryButtonStyle}" Height="45" Click="SaveButton_Click"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
