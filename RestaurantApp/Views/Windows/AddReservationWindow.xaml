<Window x:Class="RestaurantApp.Views.Windows.AddReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantApp.Views.Windows"
        mc:Ignorable="d"
        Title="{DynamicResource AddReservationTitle}" WindowStyle="None" Height="525" Width="400" 
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" 
        Background="Transparent" AllowsTransparency="True"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" 
                      ResizeBorderThickness="0" 
                      GlassFrameThickness="0" 
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BgColor}" CornerRadius="12" BorderBrush="{DynamicResource BorderDefaultColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource AddReservationTitle}" 
                       VerticalAlignment="Bottom" 
                       HorizontalAlignment="Left" 
                       FontSize="14" 
                       Margin="30,0,0,6" 
                       Foreground="{DynamicResource TextPrimaryColor}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0">
                <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{DynamicResource CloseButtonStyle}" Click="Close_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="30,20,30,20">

                <TextBlock Text="{DynamicResource GuestNameTitle}" Foreground="{DynamicResource TextSecondaryColor}" Margin="0,0,0,5"/>
                <TextBox x:Name="GuestNameTB" Style="{DynamicResource TextBoxStyle}" Tag="{DynamicResource GuestPlaceholder}" Height="42" Margin="0,0,0,15"/>

                <TextBlock Text="{DynamicResource GuestPhoneTitle}" Foreground="{DynamicResource TextSecondaryColor}" Margin="0,0,0,5"/>
                <TextBox x:Name="PhoneTB" Style="{DynamicResource TextBoxStyle}" Tag="{DynamicResource GuestPhonePlaceholder}" Height="42" Margin="0,0,0,15"
                         PreviewTextInput="NumberValidation" TextChanged="PhoneTB_TextChanged"/>

                <TextBlock Text="{DynamicResource TableTitle}" Foreground="{DynamicResource TextSecondaryColor}" Margin="0,0,0,5"/>
                <ComboBox x:Name="TableComboBox" Style="{DynamicResource ComboBoxStyle}" DisplayMemberPath="TableNumber" SelectedValuePath="ID" Margin="0,0,0,15"/>

                <TextBlock Text="{DynamicResource ReservationDateTitle}" Foreground="{DynamicResource TextSecondaryColor}" Margin="0,0,0,5"/>
                <DatePicker x:Name="ReservationDatePicker" Style="{DynamicResource DatePickerStyle}" Height="42" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource StartTimeTitle}" Foreground="{DynamicResource TextSecondaryColor}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TimeStartTB" Style="{DynamicResource TextBoxStyle}" Tag="18:00" Height="42" MaxLength="5"
                                 PreviewTextInput="NumberValidation" TextChanged="TimeTB_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource EndTimeTitle}" Foreground="{DynamicResource TextSecondaryColor}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TimeEndTB" Style="{DynamicResource TextBoxStyle}" Tag="20:00" Height="42" MaxLength="5"
                                 PreviewTextInput="NumberValidation" TextChanged="TimeTB_TextChanged"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="{DynamicResource CancelBtn}" Margin="0,0,5,0" Style="{DynamicResource SecondaryButtonStyle}" Height="45" Click="Close_Click"/>
                    <Button Grid.Column="1" Content="{DynamicResource SaveBtn}" Margin="5,0,0,0" Style="{DynamicResource PrimaryButtonStyle}" Height="45" Click="SaveButton_Click"/>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</Window>
