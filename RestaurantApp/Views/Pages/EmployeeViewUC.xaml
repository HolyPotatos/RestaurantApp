<UserControl x:Class="RestaurantApp.Views.Pages.EmployeeViewUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantApp.Views.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Foreground="{DynamicResource TextPrimaryColor}"
             Loaded="EmployeeLoaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="{DynamicResource EmployeeTitle}" FontSize="24" FontWeight="Bold" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchTB" Style="{DynamicResource TextBoxStyle}" KeyDown="SearchTB_KeyDown" Tag="{DynamicResource SearchTitle}"/>
                <Button Width="40" Style="{DynamicResource SearchButtonStyle}" Click="SearchClick"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="5,0">
                    <Button Click="AddClick" ToolTip="{DynamicResource AddButtonTooltip}" Style="{DynamicResource AddButtonStyle}"/>
                    <Button x:Name="EditButton" Click="EditClick" IsEnabled="False" ToolTip="{DynamicResource EditButtonTooltip}" Style="{DynamicResource EditButtonStyle}"/>
                    <Button x:Name="ResetPasswordButton" Click="ResetPasswordClick" IsEnabled="False" Style="{DynamicResource ResetPasswordButtonStyle}"/>
                    <Button x:Name="BlockButton" Click="BlockClick" IsEnabled="False" Style="{DynamicResource EmployeeBlockButtonStyle}"/>
                </StackPanel>
            </Grid>
            
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="EmployeeGrid"
                  Style="{DynamicResource DataGridStyle}"
                  SelectionChanged="EmployeeGrid_SelectionChanged"
                  RowDetailsVisibilityMode="Collapsed">

            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderEmployeeNumber}" Binding="{Binding ID}" Width="1.2*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderEmployeeFirstName}" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderEmployeeLastName}" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderEmployeeMiddleName}" Binding="{Binding MiddleName}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderEmployeePhoneNumber}" Binding="{Binding PhoneNumber}" Width="1.5*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderEmployeeRole}" Binding="{Binding EmployeeTitle.Title}" Width="1.2*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderEmployeeLogin}" Binding="{Binding Login}" Width="*"/>
                <DataGridTemplateColumn CanUserResize="False" Header="{DynamicResource DataGridHeaderEmployeeStatus}" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="StatusBadge" 
                                    CornerRadius="12" 
                                    Padding="10,4" 
                                    HorizontalAlignment="Left">
                                <TextBlock x:Name="StatusText" 
                                           Text="Активен" 
                                           FontSize="12" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextOnPrimaryColor}"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding isActive}" Value="False">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource DangerColor}"/>
                                    <Setter TargetName="StatusText" Property="Text" Value="{DynamicResource BlockStatus}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding isActive}" Value="True">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource SuccessColor}"/>
                                    <Setter TargetName="StatusText" Property="Text" Value="{DynamicResource ActiveStatus}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
