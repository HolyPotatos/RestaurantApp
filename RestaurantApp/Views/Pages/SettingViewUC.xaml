<UserControl x:Class="RestaurantApp.Views.Pages.SettingViewUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UCLoaded">
    <Grid>
        <StackPanel Orientation="Horizontal">
            <StackPanel Width="250" Margin="20,20,20,20" HorizontalAlignment="Left">
                <TextBlock Style="{DynamicResource TextBlockStyle}" Text="{DynamicResource ChangePasswordTitle}"/>
                <Grid Height="42" Margin="0,0,0,10">
                    <PasswordBox x:Name="UserPasswordBox" 
                                 Style="{DynamicResource PasswordBoxStyle}"
                                 PasswordChanged="UserPasswordBox_PasswordChanged"
                                 GotFocus="UserPasswordBox_GotFocus"
                                 LostFocus="UserPasswordBox_LostFocus"/>

                    <TextBlock x:Name="PasswordPlaceholder"
                               Text="{DynamicResource CurrentPasswordTitle}"
                               Foreground="{DynamicResource TextSecondaryColor}"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Margin="13,0,0,0"
                               IsHitTestVisible="False"/>
                </Grid>
                <Grid Height="42" Margin="0,0,0,10">
                    <PasswordBox x:Name="UserNewPasswordBox" 
                                 Style="{DynamicResource PasswordBoxStyle}"
                                 PasswordChanged="UserPasswordBox_PasswordChanged"
                                 GotFocus="UserPasswordBox_GotFocus"
                                 LostFocus="UserPasswordBox_LostFocus"/>

                    <TextBlock x:Name="NewPasswordPlaceholder"
                               Text="{DynamicResource NewPasswordTitle}"
                               Foreground="{DynamicResource TextSecondaryColor}"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Margin="13,0,0,0"
                               IsHitTestVisible="False"/>
                </Grid>
                <Grid Height="42" Margin="0,0,0,10">
                    <PasswordBox x:Name="RepeatUserNewPasswordBox" 
                                 Style="{DynamicResource PasswordBoxStyle}"
                                 PasswordChanged="UserPasswordBox_PasswordChanged"
                                 GotFocus="UserPasswordBox_GotFocus"
                                 LostFocus="UserPasswordBox_LostFocus"/>

                    <TextBlock x:Name="RepeatNewPasswordPlaceholder"
                               Text="{DynamicResource RepeatNewPasswordTitle}"
                               Foreground="{DynamicResource TextSecondaryColor}"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Margin="13,0,0,0"
                               IsHitTestVisible="False"/>
                </Grid>
                <Button x:Name="ChangePasswordButton" IsEnabled="False" Style="{DynamicResource PrimaryButtonStyle}" Click="ChangePasswordClick" Content="{DynamicResource ChangePasswordButton}"/>
            </StackPanel>
            <Border Width="2" CornerRadius="1" Margin="0,20" Background="{DynamicResource BorderDefaultColor}"/>
            <StackPanel Width="250" Margin="20" HorizontalAlignment="Left">
                <TextBlock Style="{DynamicResource TextBlockStyle}" Text="{DynamicResource ThemeTitle}"/>
                <ComboBox x:Name="ThemeCB" Style="{DynamicResource ComboBoxStyle}" SelectionChanged="SettingSelectionChanged" Margin="0,0,0,20">
                    <ComboBoxItem Content="{DynamicResource LightThemeTitle}"/>
                    <ComboBoxItem Content="{DynamicResource DarkThemeTitle}"/>
                </ComboBox>
                <TextBlock Style="{DynamicResource TextBlockStyle}" Text="{DynamicResource IconsTitle}"/>
                <ComboBox x:Name="IconsCB" Style="{DynamicResource ComboBoxStyle}" SelectionChanged="SettingSelectionChanged" Margin="0,0,0,20">
                    <ComboBoxItem Content="Material Design"/>
                    <ComboBoxItem Content="Lucide"/>
                </ComboBox>
                <TextBlock Style="{DynamicResource TextBlockStyle}" Text="{DynamicResource LanguageTitle}"/>
                <ComboBox x:Name="LanguageCB" Style="{DynamicResource ComboBoxStyle}" SelectionChanged="SettingSelectionChanged" Margin="0,0,0,20">
                    <ComboBoxItem Content="Русский"/>
                    <ComboBoxItem Content="English"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
