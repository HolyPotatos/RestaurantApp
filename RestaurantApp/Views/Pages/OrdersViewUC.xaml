<UserControl x:Class="RestaurantApp.Views.Pages.OrdersViewUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantApp.Views.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Foreground="{DynamicResource TextPrimaryColor}"
             Loaded="OrdersLoaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="{DynamicResource OrderTitle}" FontSize="24" FontWeight="Bold" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="155"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchTB" Style="{DynamicResource TextBoxStyle}" KeyDown="SearchTB_KeyDown" Tag="{DynamicResource SearchTitle}"/>
                <Button Width="40" Style="{DynamicResource SearchButtonStyle}" Click="SearchClick"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="5,0">
                    <Button Click="AddClick" ToolTip="{DynamicResource AddButtonTooltip}" Style="{DynamicResource AddButtonStyle}"/>
                    <Button Click="EditClick" ToolTip="{DynamicResource EditButtonTooltip}" Style="{DynamicResource EditButtonStyle}"/>
                    <Button Click="DeleteClick" ToolTip="{DynamicResource DeleteButtonTooltip}" Style="{DynamicResource DeleteButtonStyle}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="OrdersGrid"
                  Style="{DynamicResource DataGridStyle}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderOrderNumber}" Binding="{Binding ID}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderDateTime}" Binding="{Binding OrderDate, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderTable}" Binding="{Binding SeatTable.TableNumber}" Width=".5*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderEmployee}" Binding="{Binding Employee.LastName}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderPaymentType}" Binding="{Binding PaymentType.Title}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderSum}" Binding="{Binding PriceWithDiscount, StringFormat=\{0:N2\} ₽}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
