<UserControl x:Class="RestaurantApp.Views.Pages.OrdersViewUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Foreground="{DynamicResource TextPrimaryColor}"
             Loaded="OrdersLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="OrderDetailsTemplate">
            <Border Background="{DynamicResource InputDisabledBgColor}" 
                    BorderBrush="{DynamicResource BorderHoverColor}" 
                    BorderThickness="0,1,0,1" 
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource OrderDetailsTitle}" Foreground="{DynamicResource TextPrimaryColor}" FontWeight="SemiBold" FontSize="14"/>
                    <DataGrid ItemsSource="{Binding OrderDetails}" 
                              Style="{DynamicResource DataGridStyle}"
                              RowBackground="Transparent"
                              AlternatingRowBackground="Transparent"
                              Background="Transparent"
                              Foreground="{DynamicResource TextPrimaryColor}"
                              BorderThickness="0"
                              HeadersVisibility="None"
                              Focusable="False"
                              PreviewMouseWheel="InnerDataGrid_PreviewMouseWheel">
                        <DataGrid.ItemContainerStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </Style>
                        </DataGrid.ItemContainerStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Menu.Title}" Width="300" FontWeight="Medium"/>
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Quantity}" />
                                            <TextBlock Text=" x " />
                                            <TextBlock Text="{Binding Price, StringFormat=\{0:N2\}₽}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="{DynamicResource OrderTitle}" FontSize="24" FontWeight="Bold" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchTB" Style="{DynamicResource TextBoxStyle}" KeyDown="SearchTB_KeyDown" Tag="{DynamicResource SearchTitle}"/>
                <Button Width="40" Style="{DynamicResource SearchButtonStyle}" Click="SearchClick"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="5,0">
                    <Button Click="AddClick" ToolTip="{DynamicResource AddButtonTooltip}" Style="{DynamicResource AddButtonStyle}"/>
                    <Button x:Name="EditButton" Click="EditClick" IsEnabled="False" ToolTip="{DynamicResource EditButtonTooltip}" Style="{DynamicResource EditButtonStyle}"/>
                    <Button x:Name="DeleteButton" Click="DeleteClick" IsEnabled="False" ToolTip="{DynamicResource DeleteButtonTooltip}" Style="{DynamicResource DeleteButtonStyle}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="OrdersGrid"
                  Style="{DynamicResource DataGridStyle}"
                  SelectionChanged="OrdersGrid_SelectionChanged"
                  RowDetailsVisibilityMode="Collapsed"
                  RowDetailsTemplate="{DynamicResource OrderDetailsTemplate}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderOrderNumber}" Binding="{Binding ID}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderDateTime}" Binding="{Binding OrderDate, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderTable}" Binding="{Binding SeatTable.TableNumber}" Width=".5*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderEmployee}" Binding="{Binding Employee.LastName}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderPaymentType}" Binding="{Binding PaymentType.Title}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource DataGridHeaderSum}" Binding="{Binding Price, StringFormat=\{0:N2\} ₽}" Width="*"/>
                <DataGridTemplateColumn Width="50" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource DataGridExpandButtonStyle}" Click="MoreInfoClick"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
